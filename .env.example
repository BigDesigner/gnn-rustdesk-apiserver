# ==============================================================================
# GNN RustDesk Minimal API Server & Console Yapılandırması
# ==============================================================================
# Bu dosyayı sunucuda .env adıyla kopyalayarak kendi bilgilerinizi giriniz:
# Örnek: cp .env.example .env
#
# DİKKAT: .env dosyası git deposuna eklenmez (.gitignore içindedir).
# Bu sayede sunucu şifreleriniz ve IP bilgileriniz GitHub'a asla gitmez.
# ==============================================================================

# Web Konsolu ve RustDesk API Giriş Kimlik Bilgileri
RUSTDESK_API_USER=admin
RUSTDESK_API_PASS=BurayaGucluBirSifreBelirleyin

# Sunucu Port ve Çalışma Dizini
RUSTDESK_API_PORT=21114
RUSTDESK_API_DIR=/opt/rustdesk-api

# RustDesk ID / Relay Sunucu ve Özel İstemci Ayarları
RUSTDESK_SERVER_HOST=rustdesk.alanadiniz.com
RUSTDESK_SERVER_KEY=
RUSTDESK_API_URL=http://rustdesk.alanadiniz.com:21114
RUSTDESK_PRESET_PWD=
